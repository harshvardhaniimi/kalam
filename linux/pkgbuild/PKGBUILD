pkgname=kalam
pkgver=0.1.0
pkgrel=1
pkgdesc='Speech-to-text dictation for Hindi + English, private by default'
arch=('x86_64' 'aarch64')
url='https://github.com/harshvardhaniimi/kalam'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'layer-shell-qt'
         'xdg-desktop-portal' 'ffmpeg' 'wl-clipboard' 'wtype' 'libsecret' 'pipewire')
optdepends=('whisper-cpp: Local Whisper engine and offline fallback'
            'sound-theme-freedesktop: sound cues')
makedepends=('gcc' 'make')
install=kalam.install
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/kalam "$pkgdir/usr/bin/kalam"
  install -Dm755 "$startdir/omarchy-dictation-kalam" "$pkgdir/usr/bin/omarchy-dictation-kalam"
  install -Dm755 "$startdir/omarchy-install-dictation-kalam" "$pkgdir/usr/bin/omarchy-install-dictation-kalam"
  install -Dm755 "$startdir/omarchy-remove-dictation-kalam" "$pkgdir/usr/bin/omarchy-remove-dictation-kalam"
  install -Dm644 "$startdir/kalam.service" "$pkgdir/usr/lib/systemd/user/kalam.service"
  install -Dm644 -t "$pkgdir/usr/share/kalam/omarchy-plugin" omarchy-plugin/manifest.json omarchy-plugin/Widget.qml
  install -Dm644 -t "$pkgdir/usr/share/kalam/omarchy-plugin/i18n" omarchy-plugin/i18n/*.json
  install -Dm644 ../LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/kalam.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/kalam.svg"
  install -Dm644 "$startdir/kalam.desktop" "$pkgdir/usr/share/applications/kalam.desktop"
}
